# Copy to .env and fill in real values. .env itself is gitignored.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inbox_triage
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=
CLOUDMAILIN_SECRET=
APP_ENV=development
APP_ROLE=development
DASHBOARD_PASSWORD=
RUN_INLINE_WORKER=false

GEMINI_MODEL_TRIAGE=gemini-3.1-flash-lite
GEMINI_MODEL_DRAFT=gemini-3-flash

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CONFIDENCE_THRESHOLD=0.70
AUTO_SEND_ENABLED=false
AUTO_SEND_MIN_CONFIDENCE=0.90
SEMANTIC_CACHE_THRESHOLD=0.95
CORPUS_VERSION=1
MAX_VALIDATOR_RETRIES=1
MAX_REROUTES=1
WORKER_CONCURRENCY=2
RPM_LIMIT=10

INSURER_NAME=Vantara General Insurance
ALLOW_UNSIGNED_WEBHOOK=0

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_FLOOR=0.30
